{
  "rules": {
    ".read": false,
    ".write": false,
    "pricing": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'ADMIN_UID' && newData.exists()",
      ".validate": "newData.hasChildren(['currency', 'annualSaving', 'starter', 'professional', 'updatedAt', 'updatedBy'])",
      "currency": {
        ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{3}$/)"
      },
      "annualSaving": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 90"
      },
      "starter": {
        ".validate": "newData.hasChildren(['monthly', 'annual', 'seatCap'])",
        "monthly": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
        },
        "annual": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
        },
        "seatCap": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000 && newData.val() % 1 === 0"
        },
        "$other": {
          ".validate": false
        }
      },
      "professional": {
        ".validate": "newData.hasChildren(['monthly', 'annual'])",
        "monthly": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
        },
        "annual": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
        },
        "$other": {
          ".validate": false
        }
      },
      "updatedAt": {
        ".validate": "newData.val() === now"
      },
      "updatedBy": {
        ".validate": "newData.isString() && newData.val() === auth.token.email"
      },
      "$other": {
        ".validate": false
      }
    },
    "pricingHistory": {
      ".read": "auth != null && auth.uid === 'ADMIN_UID'",
      "$entry": {
        ".write": "auth != null && auth.uid === 'ADMIN_UID' && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['at', 'by', 'pricing'])",
        "at": {
          ".validate": "newData.val() === now"
        },
        "by": {
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        },
        "pricing": {
          ".validate": "newData.hasChildren(['currency', 'annualSaving', 'starter', 'professional'])"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
